# ============================================================
# Root Unified Deployment Environment Variables (.env.example)
# For Hostinger Unlimited Managed Node.js Hosting
# ============================================================

NODE_ENV=production
PORT=5000
URI=https://techorcas.com

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.dgafzmi.mongodb.net/mern-blog?retryWrites=true&w=majority

# Authentication
JWT_SECRET_KEY=your_production_secret_key_change_me
JWT_SECRET=your_production_secret_key_change_me
JWT_EXPIRE=60m
RESET_PASSWORD_EXPIRE=3600000

# Domains & CORS
FRONTEND_URL=https://techorcas.com

# Persistent Disk Upload Directory (Hostinger Managed Node.js Hosting)
# Set to absolute path on Hostinger or relative directory e.g. ./uploads
UPLOAD_DIR=/home/your-hostinger-username/domains/techorcas.com/persistent_uploads

# Nodemailer / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=partners@techorcas.com
EMAIL_PASS=your_email_app_password
