# ============================================================
# Root Unified Deployment Environment Variables (.env.example)
# For Hostinger Unlimited Managed Node.js Hosting
# ============================================================

NODE_ENV=production
PORT=5000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.dgafzmi.mongodb.net/mern-blog?retryWrites=true&w=majority

# Authentication
JWT_SECRET_KEY=your_production_secret_key_change_me
JWT_SECRET=your_production_secret_key_change_me
JWT_EXPIRE=60m

# Domains & CORS
FRONTEND_URL=https://techorcas.blog

# Permanent Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Split-Hosting (Frontend build only)
# VITE_API_URL=https://your-backend.onrender.com
