{
  "name": "blogwebapp-unified",
  "version": "1.0.0",
  "description": "TechOrcas Publishing Platform - Unified Hostinger & Split Render/Static deployment",
  "main": "server.js",
  "scripts": {
    "build": "cd Frontend && npm install --include=dev && npm run build",
    "start": "node server.js",
    "server": "cd Backend && npm start",
    "client": "cd Frontend && npm run dev",
    "install:all": "npm install && cd Backend && npm install && cd ../Frontend && npm install",
    "postinstall": "cd Backend && npm install",
    "test": "echo \"No test specified\" && exit 0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^15.0.0",
    "express": "^4.17.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.1.8",
    "multer": "^1.4.4",
    "nodemailer": "^6.7.2",
    "slugify": "^1.6.5"
  },
  "keywords": [
    "techorcas",
    "blog",
    "nodejs",
    "react",
    "express",
    "mongodb",
    "vite"
  ],
  "author": "TechOrcas",
  "license": "ISC"
}
