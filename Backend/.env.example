# ============================================================
# Backend Environment Configuration (.env.example)
# ============================================================

# Environment & Server Port
NODE_ENV=production
PORT=5000

# Base URI for application
URI=http://localhost:5000

# MongoDB Atlas Database URI (or local fallback: mongodb://127.0.0.1:27017/mern-blog)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.dgafzmi.mongodb.net/mern-blog?retryWrites=true&w=majority
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/mern-blog

# JWT Authentication Secrets
JWT_SECRET_KEY=your_strong_jwt_secret_key_here_min_32_chars
JWT_SECRET=your_strong_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=60m
RESET_PASSWORD_EXPIRE=3600000

# Allowed Frontend URL for Production CORS (e.g., https://techorcas.blog)
FRONTEND_URL=https://techorcas.blog

# Cloudinary Permanent Image Storage (Optional in local dev, recommended in production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASS=your_email_app_password
